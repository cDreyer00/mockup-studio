{
  "name": "@mockup/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "App desktop (Electron) do Mockup Studio: janela do editor, daemon embutido, render/screenshot e modo headless.",
  "license": "MIT",
  "author": "Mockup Studio",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build && node scripts/build-cli.mjs",
    "dev": "electron-vite dev",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "electron-builder --win nsis portable --config electron-builder.yml",
    "icons": "electron scripts/icons.mjs",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@mockup/core": "0.1.0",
    "@mockup/server": "0.1.0",
    "@mockup/snapshot-core": "0.1.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "vite": "^7.3.8"
  }
}
