{
  "name": "@mockup/editor",
  "version": "0.1.0",
  "private": true,
  "description": "Editor visual (canvas) do Mockup Studio.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
