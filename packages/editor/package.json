    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@mockup/core": "0.1.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.73.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^21.0.4",
    "vite": "^7.0.0"
