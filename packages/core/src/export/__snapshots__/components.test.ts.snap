exports[`React export with components > snapshot with Tailwind and with inline styles 2`] = `
{
  "code": "import type { CSSProperties, ReactNode } from 'react';

export interface ButtonProps {
  /** Visual style of the button. */
  variant?: 'default' | 'secondary' | 'outline' | 'ghost' | 'destructive';
  /** Size of the button. */
  size?: 'sm' | 'default' | 'lg';
  /** Button text. */
  label?: string;
  className?: string;
  style?: CSSProperties;
}

export function Button({
  variant = 'default',
  size = 'default',
  label = 'Button',
  className,
  style,
}: ButtonProps) {
  return (
    <button
      className={className}
      style={{
        display: 'inline-flex',
        cursor: 'pointer',
        alignItems: 'center',
        justifyContent: 'center',
        gap: '0.5rem',
        borderRadius: 'var(--radius-md)',
        borderStyle: 'solid',
        fontSize: '0.875rem',
        lineHeight: '1.4286',
        fontWeight: '500',
        whiteSpace: 'nowrap',
        boxSizing: 'border-box',
        fontFamily: 'inherit',
        textDecoration: 'none',
        backgroundColor: variant === 'destructive' ? 'var(--color-destructive)' : variant === 'ghost' ? 'transparent' : variant === 'outline' ? 'var(--color-background)' : variant === 'secondary' ? 'var(--color-secondary)' : 'var(--color-primary)',
        color: variant === 'destructive' ? '#fff' : variant === 'ghost' ? 'var(--color-foreground)' : variant === 'outline' ? 'var(--color-foreground)' : variant === 'secondary' ? 'var(--color-secondary-foreground)' : 'var(--color-primary-foreground)',
        borderWidth: variant === 'outline' ? '1px' : '0',
        borderColor: variant === 'outline' ? 'var(--color-input)' : undefined,
        boxShadow: variant === 'ghost' ? 'none' : '0 1px 2px 0 rgb(0 0 0 / 0.05)',
        paddingBlock: size === 'lg' ? undefined : size === 'sm' ? undefined : '0.5rem',
        height: size === 'lg' ? '2.5rem' : size === 'sm' ? '2rem' : '2.25rem',
        paddingInline: size === 'lg' ? '1.5rem' : size === 'sm' ? '0.75rem' : '1rem',
        ...style,
      } as CSSProperties}
      type="button"
    >
      <span
        style={{ fontSize: '0.875rem', lineHeight: '1.4286', fontWeight: '500', boxSizing: 'border-box', fontFamily: 'inherit', color: 'inherit' }}
      >
        {label}
      </span>
    </button>
  );
}

export interface CardProps {
  /** Title. */
  title?: string;
  /** Supporting text below the title. */
  description?: string;
  /** Main content. */
  content?: ReactNode;
  /** Footer (actions). */
  footer?: ReactNode;
  /** Shortcut for the "content" slot. */
  children?: ReactNode;
  className?: string;
  style?: CSSProperties;
}

export function Card({
  title = 'Card title',
  description = 'Short card description.',
  content,
  footer,
  children,
  className,
  style,
}: CardProps) {
  return (
    <div
      className={className}
      style={{
        display: 'flex',
        flexDirection: 'column',
        gap: '1.5rem',
        borderRadius: 'var(--radius-xl)',
        borderStyle: 'solid',
        borderWidth: '1px',
        backgroundColor: 'var(--color-card)',
        paddingBlock: '1.5rem',
        color: 'var(--color-card-foreground)',
        boxShadow: '0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)',
        borderColor: 'var(--color-border)',
        boxSizing: 'border-box',
        fontFamily: 'inherit',
        width: '100%',
        ...style,
      } as CSSProperties}
    >
      <div
        style={{ display: 'flex', flexDirection: 'column', gap: '0.375rem', paddingInline: '1.5rem', boxSizing: 'border-box', fontFamily: 'inherit' }}
      >
        <h3
          style={{ fontSize: '1rem', lineHeight: '1', fontWeight: '600', boxSizing: 'border-box', fontFamily: 'inherit', margin: '0', color: 'var(--color-card-foreground)' }}
        >
          {title}
        </h3>
        <p
          style={{ fontSize: '0.875rem', lineHeight: '1.4286', color: 'var(--color-muted-foreground)', boxSizing: 'border-box', fontFamily: 'inherit', margin: '0' }}
        >
          {description}
        </p>
      </div>
      <div
        style={{ paddingInline: '1.5rem', fontSize: '0.875rem', lineHeight: '1.4286', boxSizing: 'border-box', fontFamily: 'inherit' }}
        data-slot="content"
      >
        {content ?? children ?? (
          <>
            <p
              style={{ fontSize: '0.875rem', lineHeight: '1.4286', color: 'var(--color-card-foreground)', boxSizing: 'border-box', fontFamily: 'inherit', margin: '0' }}
            >
              Card content. Drag elements into this space.
            </p>
          </>
        )}
      </div>
      <div
        style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', paddingInline: '1.5rem', boxSizing: 'border-box', fontFamily: 'inherit' }}
        data-slot="footer"
      >
        {footer ?? (
          <>
            <Button size="sm" label="Action" />
          </>
        )}
      </div>
    </div>
  );
}

export function OrderScreen() {
  return (
    <div
      style={{ '--color-background': 'oklch(1 0 0)', '--color-foreground': 'oklch(0.145 0 0)', '--color-card': 'oklch(1 0 0)', '--color-card-foreground': 'oklch(0.145 0 0)', '--color-popover': 'oklch(1 0 0)', '--color-popover-foreground': 'oklch(0.145 0 0)', '--color-primary': 'oklch(0.205 0 0)', '--color-primary-foreground': 'oklch(0.985 0 0)', '--color-secondary': 'oklch(0.97 0 0)', '--color-secondary-foreground': 'oklch(0.205 0 0)', '--color-muted': 'oklch(0.97 0 0)', '--color-muted-foreground': 'oklch(0.556 0 0)', '--color-accent': 'oklch(0.97 0 0)', '--color-accent-foreground': 'oklch(0.205 0 0)', '--color-destructive': 'oklch(0.577 0.245 27.325)', '--color-border': 'oklch(0.922 0 0)', '--color-input': 'oklch(0.922 0 0)', '--color-ring': 'oklch(0.708 0 0)', '--radius': '0.625rem', '--radius-sm': 'calc(var(--radius) - 4px)', '--radius-md': 'calc(var(--radius) - 2px)', '--radius-lg': 'var(--radius)', '--radius-xl': 'calc(var(--radius) + 4px)', width: '800px', display: 'flex', flexDirection: 'column', minHeight: '600px' } as CSSProperties}
    >
      <Button variant="outline" label="Save" />
      <Button size="lg" style={{ marginTop: '8px' }} />
      <Card
        title="Order"
        footer={
          <Button label="Confirm" />
        }
      >
        <p>Card body</p>
      </Card>
    </div>
  );
}

export default OrderScreen;
