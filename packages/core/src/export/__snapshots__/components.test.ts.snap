exports[`React export with components > snapshot with Tailwind and with inline styles 1`] = `
{
  "code": "import type { CSSProperties, ReactNode } from 'react';

export interface ButtonProps {
  /** Visual style of the button. */
  variant?: 'default' | 'secondary' | 'outline' | 'ghost' | 'destructive';
  /** Size of the button. */
  size?: 'sm' | 'default' | 'lg';
  /** Button text. */
  label?: string;
  className?: string;
  style?: CSSProperties;
}

export function Button({
  variant = 'default',
  size = 'default',
  label = 'Button',
  className,
  style,
}: ButtonProps) {
  return (
    <button
      className={[
        'inline-flex cursor-pointer items-center justify-center gap-2 rounded-md border-solid text-sm leading-[1.4286] font-medium whitespace-nowrap box-border [font-family:inherit] no-underline',
        variant === 'destructive' ? 'bg-destructive' : variant === 'ghost' ? 'bg-transparent' : variant === 'outline' ? 'bg-background' : variant === 'secondary' ? 'bg-secondary' : 'bg-primary',
        variant === 'destructive' ? 'text-white' : variant === 'ghost' ? 'text-foreground' : variant === 'outline' ? 'text-foreground' : variant === 'secondary' ? 'text-secondary-foreground' : 'text-primary-foreground',
        variant === 'outline' ? 'border' : 'border-0',
        variant === 'outline' ? 'border-input' : '',
        variant === 'ghost' ? 'shadow-none' : 'shadow-[0_1px_2px_0_rgb(0_0_0_/_0.05)]',
        size === 'lg' ? '' : size === 'sm' ? '' : 'py-2',
        size === 'lg' ? 'h-10' : size === 'sm' ? 'h-8' : 'h-9',
        size === 'lg' ? 'px-6' : size === 'sm' ? 'px-3' : 'px-4',
        variant === 'destructive' ? 'hover:bg-[color-mix(in_oklab,var(--color-destructive)_90%,transparent)]' : variant === 'ghost' ? 'hover:bg-accent' : variant === 'outline' ? 'hover:bg-accent' : variant === 'secondary' ? 'hover:bg-[color-mix(in_oklab,var(--color-secondary)_80%,transparent)]' : 'hover:bg-[color-mix(in_oklab,var(--color-primary)_90%,transparent)]',
        variant === 'ghost' ? 'hover:text-accent-foreground' : variant === 'outline' ? 'hover:text-accent-foreground' : '',
        className,
      ].filter(Boolean).join(' ')}
      style={style}
      type="button"
    >
      <span
        className="text-sm leading-[1.4286] font-medium box-border [font-family:inherit] [color:inherit]"
      >
        {label}
      </span>
    </button>
  );
}

export interface CardProps {
  /** Title. */
  title?: string;
  /** Supporting text below the title. */
  description?: string;
  /** Main content. */
  content?: ReactNode;
  /** Footer (actions). */
  footer?: ReactNode;
  /** Shortcut for the "content" slot. */
  children?: ReactNode;
  className?: string;
  style?: CSSProperties;
}

export function Card({
  title = 'Card title',
  description = 'Short card description.',
  content,
  footer,
  children,
  className,
  style,
}: CardProps) {
  return (
    <div
      className={[
        'flex flex-col gap-6 rounded-xl border-solid border bg-card py-6 text-card-foreground shadow-[0_1px_3px_0_rgb(0_0_0_/_0.1),0_1px_2px_-1px_rgb(0_0_0_/_0.1)] border-border box-border [font-family:inherit] w-full',
        className,
      ].filter(Boolean).join(' ')}
      style={style}
    >
      <div className="flex flex-col gap-1.5 px-6 box-border [font-family:inherit]">
        <h3
          className="text-base leading-none font-semibold box-border [font-family:inherit] m-0 text-card-foreground"
        >
          {title}
        </h3>
        <p
          className="text-sm leading-[1.4286] text-muted-foreground box-border [font-family:inherit] m-0"
        >
          {description}
        </p>
      </div>
      <div
        className="px-6 text-sm leading-[1.4286] box-border [font-family:inherit]"
        data-slot="content"
      >
        {content ?? children ?? (
          <>
            <p
              className="text-sm leading-[1.4286] text-card-foreground box-border [font-family:inherit] m-0"
            >
              Card content. Drag elements into this space.
            </p>
          </>
        )}
      </div>
      <div
        className="flex items-center gap-2 px-6 box-border [font-family:inherit]"
        data-slot="footer"
      >
        {footer ?? (
          <>
            <Button size="sm" label="Action" />
          </>
        )}
      </div>
    </div>
  );
}

export function OrderScreen() {
  return (
    <div className="w-[800px] flex flex-col min-h-[600px]">
      <Button variant="outline" label="Save" />
      <Button size="lg" style={{ marginTop: '8px' }} />
      <Card
        title="Order"
        footer={
          <Button label="Confirm" />
        }
      >
        <p>Card body</p>
      </Card>
    </div>
  );
}

export default OrderScreen;
