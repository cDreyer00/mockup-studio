{
  "code": "import { useEffect, type CSSProperties } from 'react';

/** Builds: click / ArrowRight / Space / PageDown plays the next build (ArrowLeft / PageUp rewinds). */
function installBuilds(): () => void {
  let step = 0;
  let list: Animation[][] | null = null;
  // collected on the first step: a finished animation leaves getAnimations()
  const builds = (): Animation[][] => {
    const seen = new Map<number, Animation[]>();
    for (const a of document.getAnimations()) {
      const m = /-b(\\d+)$/.exec((a as CSSAnimation).animationName ?? "");
      if (m) seen.set(Number(m[1]), [...(seen.get(Number(m[1])) ?? []), a]);
    }
    return [...seen].sort(([x], [y]) => x - y).map(([, anims]) => anims);
  };
  const go = (dir: number): void => {
    list = list ?? builds();
    if (dir > 0 && step < list.length) list[step++].forEach((a) => a.play());
    else if (dir < 0 && step > 0) {
      list[--step].forEach((a) => {
        a.pause();
        a.currentTime = 0;
      });
    }
  };
  const onClick = (e: MouseEvent): void => {
    if (!(e.target as Element).closest?.('a, button, input, select, textarea')) go(1);
  };
  const onKey = (e: KeyboardEvent): void => {
    if ((e.target as Element).closest?.('input, select, textarea')) return;
    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') {
      e.preventDefault();
      go(1);
    } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
      e.preventDefault();
      go(-1);
    }
  };
  document.addEventListener('click', onClick);
  document.addEventListener('keydown', onKey);
  return () => {
    document.removeEventListener('click', onClick);
    document.removeEventListener('keydown', onKey);
  };
}

export function Screen() {
  useEffect(() => installBuilds(), []);

  return (
    <div style={{ width: '400px', minHeight: '300px' }}>
      <h1 style={{ fontSize: '32px' }} data-mk="1">
        <span data-motion-word="">
          <span data-motion-seg="" style={{ '--mi': '0' } as CSSProperties}>H</span>
          <span data-motion-seg="" style={{ '--mi': '1' } as CSSProperties}>e</span>
          <span data-motion-seg="" style={{ '--mi': '2' } as CSSProperties}>l</span>
          <span data-motion-seg="" style={{ '--mi': '3' } as CSSProperties}>l</span>
          <span data-motion-seg="" style={{ '--mi': '4' } as CSSProperties}>o</span>
        </span>
        {' '}
        <span data-motion-word="">
          <span data-motion-seg="" style={{ '--mi': '5' } as CSSProperties}>b</span>
          <span data-motion-seg="" style={{ '--mi': '6' } as CSSProperties}>i</span>
          <span data-motion-seg="" style={{ '--mi': '7' } as CSSProperties}>g</span>
        </span>
        {' '}
        <span data-motion-word="">
          <span data-motion-seg="" style={{ '--mi': '8' } as CSSProperties}>w</span>
          <span data-motion-seg="" style={{ '--mi': '9' } as CSSProperties}>o</span>
          <span data-motion-seg="" style={{ '--mi': '10' } as CSSProperties}>r</span>
          <span data-motion-seg="" style={{ '--mi': '11' } as CSSProperties}>l</span>
          <span data-motion-seg="" style={{ '--mi': '12' } as CSSProperties}>d</span>
        </span>
      </h1>
      <div style={{ width: '40px', height: '40px' }} data-mk="2" />
      <ul data-mk="6">
        <li style={{ padding: '4px' }} data-mk="3">One</li>
        <li style={{ padding: '4px' }} data-mk="4">Two</li>
        <li style={{ padding: '4px' }} data-mk="5">Three</li>
      </ul>
      <div style={{ width: '10px', height: '10px' }} data-mk="7" />
    </div>
  );
}

export default Screen;
