      0% { translate: 0px 0px; }
      50% { translate: 0px -10px; }
      100% { translate: 0px 0px; }
    }
    @keyframes mk-883ffc-b1 {
      0% { transform: translate3d(0px, 24px, 0px); opacity: 0; }
      100% { transform: translate3d(0px, 0px, 0px); opacity: 1; }
    }
    @keyframes mk-9a813f-b2 {
      0% { opacity: 1; }
      100% { opacity: 0; }
    }
    @keyframes mk-37a9dd {
      0% { transform: scale(1); }
      100% { transform: scale(1.2); }
    }
    [data-mk="1"] [data-motion-seg] {
      animation: mk-883ffc 600ms cubic-bezier(0.05, 0.7, 0.1, 1) calc(var(--mi) * 30ms + 0ms) 1 normal backwards;
    }
    [data-mk="2"] {
      animation: mk-883ffc 600ms cubic-bezier(0.05, 0.7, 0.1, 1) 0ms 1 normal backwards, mk-4b23bf 3000ms ease-in-out 0ms infinite normal none;
    }
    [data-mk="3"] {
      animation: mk-883ffc-b1 600ms cubic-bezier(0.05, 0.7, 0.1, 1) 0ms 1 normal backwards;
      animation-play-state: paused;
    }
    [data-mk="4"] {
      animation: mk-883ffc-b1 600ms cubic-bezier(0.05, 0.7, 0.1, 1) 100ms 1 normal backwards;
      animation-play-state: paused;
    }
    [data-mk="5"] {
      animation: mk-883ffc-b1 600ms cubic-bezier(0.05, 0.7, 0.1, 1) 200ms 1 normal backwards;
      animation-play-state: paused;
    }
    [data-mk="6"] {
      animation: mk-9a813f-b2 300ms cubic-bezier(0.4, 0, 0.2, 1) 0ms 1 normal forwards;
      animation-play-state: paused;
    }
    [data-mk="7"] {
      animation: mk-37a9dd 800ms cubic-bezier(0.4, 0, 0.2, 1) 0ms 1 normal none;
    }
  }
  </style>
</head>
<body>
  <div class="screen">
    <h1 class="title" data-mk="1"><span data-motion-word><span data-motion-seg style="--mi: 0">H</span><span data-motion-seg style="--mi: 1">e</span><span data-motion-seg style="--mi: 2">l</span><span data-motion-seg style="--mi: 3">l</span><span data-motion-seg style="--mi: 4">o</span></span> <span data-motion-word><span data-motion-seg style="--mi: 5">b</span><span data-motion-seg style="--mi: 6">i</span><span data-motion-seg style="--mi: 7">g</span></span> <span data-motion-word><span data-motion-seg style="--mi: 8">w</span><span data-motion-seg style="--mi: 9">o</span><span data-motion-seg style="--mi: 10">r</span><span data-motion-seg style="--mi: 11">l</span><span data-motion-seg style="--mi: 12">d</span></span></h1>
    <div class="badge" data-mk="2"></div>
    <ul data-mk="6">
      <li class="item" data-mk="3">One</li>
      <li class="item-2" data-mk="4">Two</li>
      <li class="item-3" data-mk="5">Three</li>
    </ul>
    <div class="custom" data-mk="7"></div>
  </div>
<script>
// Builds: click / ArrowRight / Space / PageDown plays the next build (ArrowLeft / PageUp rewinds).
(function () {
  var step = 0, list = null;
  function builds() {
    var seen = {};
    document.getAnimations().forEach(function (a) {
      var m = /-b(\\d+)$/.exec(a.animationName || "");
      if (m) (seen[m[1]] || (seen[m[1]] = [])).push(a);
    });
    return Object.keys(seen).sort(function (x, y) { return x - y; }).map(function (b) { return seen[b]; });
  }
  function go(dir) {
    list = list || builds();
    if (dir > 0 && step < list.length) list[step++].forEach(function (a) { a.play(); });
    else if (dir < 0 && step > 0) list[--step].forEach(function (a) { a.pause(); a.currentTime = 0; });
  }
  function onClick(e) {
    if (!e.target.closest || !e.target.closest('a, button, input, select, textarea')) go(1);
  }
  function onKey(e) {
    if (e.target.closest && e.target.closest('input, select, textarea')) return;
    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') { e.preventDefault(); go(1); }
    else if (e.key === 'ArrowLeft' || e.key === 'PageUp') { e.preventDefault(); go(-1); }
  }
  document.addEventListener('click', onClick);
  document.addEventListener('keydown', onKey);
})();
</script>
</body>
</html>
"
