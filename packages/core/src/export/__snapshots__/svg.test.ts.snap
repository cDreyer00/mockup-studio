    <div xmlns="http://www.w3.org/1999/xhtml" style="--color-bg: #0f1115; --color-surface: #181b22; --color-primary: #6c5ce7; --color-text: #e8e8ee; --color-muted: #9aa0ad; --radius: 12px; --font: Inter, system-ui, sans-serif">
      <style>*,*::before,*::after{box-sizing:border-box;margin:0}
