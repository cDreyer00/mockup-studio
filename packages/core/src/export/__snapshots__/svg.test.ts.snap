        </section>
        <section style="display: flex; flex-direction: column; gap: 16px; padding: 16px 20px 40px">
          <div style="display: flex; flex-direction: column; gap: 8px; padding: 20px; background-color: var(--color-surface); border-radius: var(--radius)">
            <div style="font-size: 28px">🎨</div>
            <h3 style="font-size: 18px; font-weight: 700">Design livre</h3>
            <p style="font-size: 14px; line-height: 1.5; color: var(--color-muted)">Posicione frames no canvas e ajuste cada propriedade CSS.</p>
          </div>
