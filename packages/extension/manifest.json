{
  "manifest_version": 3,
  "name": "Mockup Studio — Capturar seção",
  "version": "0.1.0",
  "description": "Captura a seção sob o cursor de qualquer site e a envia ao Mockup Studio como um frame editável.",
  "action": {
    "default_title": "Capturar seção para o Mockup Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "clipboardWrite"]
}
