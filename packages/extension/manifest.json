{
  "manifest_version": 3,
  "name": "Mockup Studio — Capture section",
  "version": "0.1.0",
  "description": "Captures the section under the cursor on any site and sends it to Mockup Studio as an editable frame.",
  "key": "",
  "action": {
    "default_title": "Capture section to Mockup Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "clipboardWrite"]
}
