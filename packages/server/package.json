{
  "name": "@mockup/server",
  "version": "0.1.0",
  "private": true,
  "description": "Daemon local do Mockup Studio: documentos abertos, HTTP, WebSocket e servidor MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mockup-daemon": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node dist/bin.js",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@mockup/core": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-static": "^1.73.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/ws": "^8.18.1"
  }
}
